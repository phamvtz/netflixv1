# ─── Netflix v1 — biến môi trường ───────────────────────────────
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env.

# Cổng server (mặc định 3002)
PORT=3002

# Token cho admin API. Bỏ trống → server tự sinh ngẫu nhiên mỗi lần khởi động
# (in ra console). Set cố định cho production.
ADMIN_TOKEN=

# Tắt verify TLS cho request ra ngoài. Mặc định BẬT bảo mật.
# Chỉ đặt =1 khi cần debug lỗi certificate.
INSECURE_TLS=0

# Chế độ nftoken.site: off (mặc định) | parallel | fallback
NFTOKEN_MODE=off

# Cloudflare Turnstile. Mặc định dùng test keys (luôn pass).
# Đặt TURNSTILE_DISABLED=1 để tắt hẳn captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=

# Đường dẫn file SQLite (mặc định ./netflix.db ở thư mục gốc dự án)
NETFLIX_DB_PATH=
