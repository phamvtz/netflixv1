# ─── Netflix v1 — biến môi trường ───────────────────────────────
# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env.

# Cổng server (mặc định 3002)
PORT=3002

# Token cho admin API (backward-compat). Bỏ trống → server tự sinh ngẫu nhiên mỗi
# lần khởi động (in ra console). Admin cũng có thể đăng nhập bằng tài khoản.
ADMIN_TOKEN=

# Tắt verify TLS cho request ra ngoài. Mặc định BẬT bảo mật.
# Chỉ đặt =1 khi cần debug lỗi certificate.
INSECURE_TLS=0

# Chế độ nftoken.site: fallback (mặc định) | off | parallel
# fallback = direct trước, gọi nftoken nếu thiếu email / không vào được /account
NFTOKEN_MODE=fallback

# Tốc độ checker: stealth (mặc định, an toàn) | slow | normal
# stealth/chậm = warmup browse → account, không nftoken, delay dài
CHECK_PACE=stealth
# Giới hạn check/giờ từ 1 IP (tránh burst)
CHECK_MAX_PER_HOUR=50
# Số cookie tối đa cho 1 request batch check
CHECK_BATCH_MAX=50

# Bật cờ Secure cho session cookie (chỉ bật khi chạy sau TLS/https)
COOKIE_SECURE=0

# Cloudflare Turnstile (widget thật — không còn banner "For testing only")
# 1) https://dash.cloudflare.com → Turnstile → Add site → Managed
# 2) Hostnames: localhost, 127.0.0.1, domain production của bạn
# 3) Copy Site Key + Secret Key vào dưới, restart server
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
# Tắt captcha: TURNSTILE_DISABLED=1
# Chỉ dev (widget test Cloudflare): TURNSTILE_USE_TEST=1
TURNSTILE_DISABLED=
TURNSTILE_USE_TEST=

# Đường dẫn file SQLite (mặc định ./netflix.db ở thư mục gốc dự án)
NETFLIX_DB_PATH=

# ─── Temp-mail provider: tempmail.id.vn (lấy mã Netflix cho khách) ────
# 1) Tạo tài khoản tại https://tempmail.id.vn → mục API → tạo API token (chỉ hiện 1 lần).
# 2) Các mailbox khách dùng phải thuộc tài khoản sở hữu token này.
# Thiếu token → /api/inbox trả rỗng (không lấy được mã).
TEMPMAIL_TOKEN=
# Base URL API (ít khi cần đổi)
TEMPMAIL_API_BASE=https://tempmail.id.vn
# Số message tối đa đọc mỗi hộp thư
TEMPMAIL_MAX_MESSAGES=15
# Danh sách domain cho phép (phân tách bằng dấu phẩy) — dùng cho /api/domains
TEMPMAIL_DOMAINS=tempmail.id.vn

# ─── Auto-check bảo hành (định kỳ check lại cookie order còn hạn) ─────
# Tắt hẳn: WARRANTY_CHECK=0
WARRANTY_CHECK=1
# Chu kỳ quét (phút)
WARRANTY_INTERVAL_MIN=30
# Mỗi order chỉ check lại tối thiểu sau N giây (mặc định 6 giờ)
WARRANTY_MIN_INTERVAL_SEC=21600
# Số order tối đa xử lý mỗi lần quét
WARRANTY_BATCH=10

# ─── Nạp tiền — thông tin ngân hàng (hiện ở trang Seller → Nạp tiền) ──
# Để trống → trang nạp tiền hiện "Chưa cấu hình — liên hệ admin" (không có số giả).
# BANK_CODE theo chuẩn VietQR (VCB, TCB, MB, ACB, BIDV, VPB, TPB...).
BANK_CODE=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# Tiền tố nội dung chuyển khoản; hệ thống nối thêm username seller. VD: "NAP" → "NAP mortal"
BANK_MEMO_PREFIX=NAP

# Webhook: Casso / SePay tự động cộng số dư khi nhận chuyển khoản.
# 1) Tạo token bí mật (ít nhất 32 ký tự ngẫu nhiên).
# 2) Cấu hình bên Casso/SePay gọi POST tới `https://<domain>/api/deposit/webhook`
#    với header `Authorization: Bearer <token>` (hoặc `?token=<token>`).
# 3) Hệ thống parse memo "<BANK_MEMO_PREFIX> <username>" → cộng vào tài khoản seller đúng.
# Để trống → endpoint trả 401, không tự cộng.
BANK_WEBHOOK_TOKEN=

# ─── SMTP — gửi mã xác minh email cho seller ────────────────────
# Thiếu các biến này → server vẫn chạy, mã xác minh được LOG ra console (chế độ dev).
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<app password 16 ký tự> (bật 2FA rồi tạo App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
